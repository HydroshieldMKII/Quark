msgid "newer than tested"
msgstr "plus récente que la version testée"

msgid "version %s"
msgstr "version %s"

msgid "waiting"
msgstr "en attente"

msgid "“%s” added to Shared with me"
msgstr "« %s » ajouté à Partagés avec moi"

msgid "“%s” is not a valid email address."
msgstr "« %s » n’est pas une adresse électronique valide."

msgid "“%s” is not marked as a program yet. Quark can allow it to run. Only do this for the official Proton Drive CLI downloaded from proton.me."
msgstr "« %s » n’est pas encore marqué comme programme. Quark peut l’autoriser à s’exécuter. Ne le faites que pour le CLI officiel de Proton Drive téléchargé depuis proton.me."
